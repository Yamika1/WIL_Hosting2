```cshtml
@model ReCenterHub.Models.WorkshopBooking

@{
    ViewData["Title"] = "Book a Workshop";
}

<div class="form-card">
    <div class="form-intro">
        <h1>Book a Workshop</h1>
        <p class="text-muted">Tell us about your institution and the workshop you need.</p>
    </div>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <partial name="_Fields" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn-brand">Submit request</button>
            <a asp-action="Index" class="btn-outline-brand">Cancel</a>
        </div>
    </form>
</div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}