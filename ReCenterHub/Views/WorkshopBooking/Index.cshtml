@model IEnumerable<ReCenterHub.Models.WorkshopBooking>

@{
    ViewData["Title"] = "Workshop Bookings";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1>Workshop Bookings</h1>
            <p class="text-muted mb-0">Manage your institution's workshop requests.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Book a Workshop</a>
    </div>

    @if (TempData["Notification"] != null)
    {
        <div class="alert alert-success">@TempData["Notification"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Index" method="get" class="card card-body mb-4">
        <div class="row g-3">
            <div class="col-md-6">
                <label for="instituitionName" class="form-label">Institution Name</label>
                <input type="text" name="instituitionName" id="instituitionName"
                       class="form-control" placeholder="Search institution" />
            </div>

            <div class="col-md-6">
                <label for="topic" class="form-label">Workshop Topic</label>
                <input type="text" name="topic" id="topic"
                       class="form-control" placeholder="Search topic" />
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No workshop bookings were found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Institution</th>
                        <th>Target Audience</th>
                        <th>Topic</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Date and Time</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td>@booking.InstitutionName</td>
                            <td>@booking.TargetAudience</td>
                            <td>@(string.IsNullOrWhiteSpace(booking.Topic) ? "Not specified" : booking.Topic)</td>
                            <td>@booking.PhoneNumber</td>
                            <td>@booking.EmailAddress</td>
                            <td>@booking.Date_and_Time.ToString("dd MMM yyyy, HH:mm")</td>
                            <td>@(string.IsNullOrWhiteSpace(booking.Status) ? "Pending" : booking.Status)</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Update"
                                       asp-route-id="@booking.WorkshopBookingID"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@booking.WorkshopBookingID"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this workshop booking?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>