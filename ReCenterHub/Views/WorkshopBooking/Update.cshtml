@model ReCenterHub.Models.WorkshopBooking

@{
    ViewData["Title"] = "Update Workshop Booking";
    var status = string.IsNullOrWhiteSpace(Model.Status) ? "Pending" : Model.Status;
}

<div class="form-card">
    <div class="form-intro">
        <h1>Update Workshop Booking</h1>
        <p class="text-muted">
            Edit the information for your workshop request.
            Current status: <span class="status-chip status-@status.ToLower()">@status</span>
        </p>
    </div>

    <form asp-action="Update" asp-route-id="@Model.WorkshopBookingID" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <partial name="_Fields" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn-brand">Save changes</button>
            <a asp-action="Index" class="btn-outline-brand">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}