@{
    ViewData["Title"] = "About Re-Center Hub";
}

<div class="page-heading">
    <span class="eyebrow">Our purpose</span>
    <h1>About Re-Center Hub</h1>
    <p>A Hub for Growth. A Path to Purpose.</p>
</div>

<section class="about-copy">
    <h2>Welcome to Re-Center Hub</h2>

    <p>
        A space dedicated to rebuilding minds, re-centering lives,
        and empowering growth.
    </p>

    <p>
        At Re-Center Hub, we are passionate about supporting young
        people, families and communities through:
    </p>

    <ul>
        <li>Counselling and wellness</li>
        <li>Life skills and education</li>
        <li>Youth development and mentorship</li>
    </ul>

    <p>
        We believe that every young person deserves support,
        guidance, healing and the opportunity to discover their
        purpose. This is more than a service — it is a journey
        toward transformation, hope and meaningful change.
    </p>
</section>

<section class="content-card" style="margin-top:1.25rem">
    <div class="mission-band" style="margin-top:0">
        <h2>Our Mission</h2>
        <p class="mb-0">
            To empower children, young people, families and schools
            through meaningful support, practical interventions
            and holistic development opportunities.
        </p>
    </div>

    <h2 style="color:var(--olive);margin-top:1.6rem">
        Why Re-Center Hub?
    </h2>

    <div class="feature-grid">
        <article class="feature-card">
            <h2>Qualified practice</h2>
            <p>
                Child and youth care practitioner with school
                counselling experience.
            </p>
        </article>

        <article class="feature-card">
            <h2>Research-informed</h2>
            <p>
                Support shaped by research-informed practice and
                intervention facilitation.
            </p>
        </article>

        <article class="feature-card">
            <h2>Tailored programmes</h2>
            <p>
                Programmes designed around the needs of learners,
                families, schools and organisations.
            </p>
        </article>
    </div>

    <p class="mt-3 mb-0">
        The founder is registered with SACSSP.
    </p>
</section>