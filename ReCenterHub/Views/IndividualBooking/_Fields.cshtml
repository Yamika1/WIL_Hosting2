@model ReCenterHub.Models.IndividualBooking

<div class="form-grid">
    <div class="form-field">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
        <span asp-validation-for="FirstName" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="Surname" class="form-label"></label>
        <input asp-for="Surname" class="form-control" autocomplete="family-name" />
        <span asp-validation-for="Surname" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category"
                asp-items="@(new SelectList(BookingOptions.IndividualCategories))"
                class="form-select">
            <option value="">Select a category</option>
        </select>
        <span asp-validation-for="Category" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" type="tel" autocomplete="tel" />
        <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="EmailAddress" class="form-label"></label>
        <input asp-for="EmailAddress" class="form-control" type="email" autocomplete="email" />
        <span asp-validation-for="EmailAddress" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="Date_and_Time" class="form-label"></label>
        <input asp-for="Date_and_Time"
               class="form-control"
               type="datetime-local"
               asp-format="{0:yyyy-MM-ddTHH:mm}"
               min="@(Model.IndividualBookingID == 0 ? DateTime.Now.ToString("yyyy-MM-ddTHH:mm") : null)" />
        <span asp-validation-for="Date_and_Time" class="field-validation-error"></span>
    </div>

    <div class="form-field full-width">
        <label asp-for="OptionalNotes" class="form-label"></label>
        <textarea asp-for="OptionalNotes" class="form-control" rows="4"
                  placeholder="Add any additional information (optional)"></textarea>
        <span asp-validation-for="OptionalNotes" class="field-validation-error"></span>
    </div>
</div>