@model ReCenterHub.Models.IndividualBooking

@{
    ViewData["Title"] = "Book an Individual Session";
}

<div class="form-card">
    <div class="form-intro">
        <h1>Book an Individual Session</h1>
        <p class="text-muted">Complete the details below to request a session.</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
    <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <partial name="_Fields" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn-brand">Submit booking</button>
            <a asp-action="Index" class="btn-outline-brand">Cancel</a>
        </div>
    </form>
</div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}